# Stage 1: Build & Package Frontend assets
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY package*.json ./
# Install dependencies if present
RUN npm install --ignore-scripts || true
COPY src/main/resources/static ./dist

# Stage 2: Minimal runtime using Nginx unprivileged
FROM nginx:alpine
WORKDIR /usr/share/nginx/html
# Clean default static assets
RUN rm -rf ./*
# Copy compiled / bundled assets from builder stage
COPY --from=frontend-builder /app/dist .
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
